---
import { Image } from "astro:assets";
import cells from "~src/assets/images/application/cells.png";
import slides from "~src/assets/images/application/slides.jpg";
import networking from "~src/assets/images/application/networking.jpg";
import textureMask from "~src/assets/images/application/app-texture-mask.png";
import physicianReview from "~src/assets/images/application/physician-review.webp";
import report from "~src/assets/images/application/report.jpg";
import BytesCorner from "~src/assets/backgrounds/bytes/in-element-corner.svg";

import { WIDTHS } from "~src/consts";
import Section from "~src/components/Section.astro";
import H from "~src/components/HeadingLink.astro";
import Layout from "~src/layouts/Layout.astro";
import type { PageMeta } from "~src/utils/opengraph";
import WorkflowStep from "~src/components/WorkflowStep.astro";
import ApplicationScroller from "~src/components/ApplicationScroller.astro";
import ContentBlock from "~src/components/ContentBlock.astro";
import DecoratedCard from "~src/components/DecoratedCard.astro";
import Pair from "~src/components/Pair.astro";

import Collaboration from "~src/assets/icons/keyFeatures/collaboration.svg";
import Comprehensive from "~src/assets/icons/keyFeatures/comprehensive.svg";
import Reference from "~src/assets/icons/keyFeatures/reference.svg";
import Report from "~src/assets/icons/keyFeatures/report.svg";
import SingleCell from "~src/assets/icons/keyFeatures/singlecell.svg";
import Triage from "~src/assets/icons/keyFeatures/triage.svg";
import Card from "~src/components/Card.astro";
import BytesSection from "~src/components/BytesSection.astro";
import HeroSection from "~src/components/HeroSection.astro";

export const meta = {
  title: "Application | Cellbytes",
  description:
    "Triage, review and report bone marrow aspirates and peripheral blood smears in one browser-based workflow, with AI pre-classification of every cell.",
  card: { title: "The Cellbytes application", image: physicianReview },
} satisfies PageMeta;
---

<Layout {...meta}>
  <HeroSection>
    <Pair reversed>
      <Image
        src={cells}
        alt="100 times magnified image of blood cells, with annotated bounding boxes around white blood cells labeled by Cellbytes."
        widths={WIDTHS}
        height="300"
      />
      <ContentBlock>
        <h1>A new era</h1>
        <p class="ingress">
          Digital cytopathology streamlines workflows by bridging physicians and
          technology. With AI managing time-consuming, quantifiable tasks, human
          experts apply their clinical judgment to verify and interpret results.
          To support interpretation, Cellbytes is the first platform to also
          provide reference values for healthy subjects. Remote collaboration
          becomes effortless, enabling seamless sample evaluation and colleague
          consultations. Cellbytes brings digital cytopathology to life.
        </p>
      </ContentBlock>
    </Pair>
  </HeroSection>

  <Section class="workflow">
    <H level="2">Cellbytes workflow</H>
    <ol>
      <WorkflowStep
        image={slides}
        alt="A doctor skimming through a drawer filled with bone marrow slides."
        heading="Scan slides"
        text="Capture cytomorphological slides using your microscope."
      />
      <WorkflowStep
        image={networking}
        alt="A rack of servers with networking cables running from one to another."
        heading="Automatic upload"
        text="Images are securely uploaded to the cloud-based file storage."
      />
      <WorkflowStep
        image={textureMask}
        alt="A screenshot of Cellbytes showing slide texture overlay mask."
        heading="Feature extraction"
        text="Cellbytes analyzes key features from whole-slide and single-cell images."
      />
      <WorkflowStep
        image={physicianReview}
        alt="A physician reviewing cells using Cellbytes."
        heading="Physician review"
        text="Review pre-classification results."
      />
      <WorkflowStep
        image={report}
        alt="A doctor reviewing a report, holding a pen in hand."
        heading="Seamless reporting"
        text="Share a standardized digital report directly to your laboratory information system or export them for research purposes."
      />
    </ol>
  </Section>

  <DecoratedCard variant="bytes">
    <H level="2">Key features</H>

    <div class="card-grid">
      <Card class="card-item feature">
        <Triage class="art-icon-triage" />
        <H level="3">Sample triage</H>
        <p>Prioritize urgent samples with a multi-parameter risk model.</p>
      </Card>
      <Card class="card-item feature">
        <Comprehensive class="art-icon-comprehensive" />
        <H level="3">Comprehensive image view</H>
        <p>Access whole-slide images, numerical analysis, and visual masks.</p>
      </Card>
      <Card class="card-item feature">
        <SingleCell class="art-icon-singlecell" />
        <H level="3">Single-cell analysis</H>
        <p>
          View single-cell images with classifications and potential dysplasia
          indicators.
        </p>
      </Card>
      <Card class="card-item feature">
        <Reference class="art-icon-reference" />
        <H level="3">Reference comparisons</H>
        <p>Compare results with population-scale reference ranges.</p>
      </Card>
      <Card class="card-item feature">
        <Report class="art-icon-report" />
        <H level="3">Standardized reporting</H>
        <p>
          Assess and share clinically essential findings in a structured report.
        </p>
      </Card>
      <Card class="card-item feature">
        <Collaboration class="art-icon-collaboration" />
        <H level="3">Collaborative sharing</H>
        <p>
          Easily share slides and cell images with colleagues for consultations
          and meetings.
        </p>
      </Card>
    </div>
  </DecoratedCard>

  <ApplicationScroller />

  <BytesSection color="purple">
    <BytesCorner class="art-bytes-in-element-corner bytes-corner" />

    <H level="2">Frequently asked questions</H>
    <div class="card-grid">
      <Card class="card-item faq">
        <H level="3">How can I use Cellbytes?</H>
        <p>
          Cellbytes can be used by uploading high-resolution images of bone
          marrow aspirates to the platform. The application analyzes these
          images using advanced machine learning algorithms, delivering
          quantitative results and visual annotations. It is accessible via a
          secure web interface—no installation required.
        </p>
      </Card>
      <Card class="card-item faq">
        <H level="3">Can I test Cellbytes?</H>
        <p>
          Yes, Cellbytes offers a trial version for institutions and
          professionals interested in evaluating its capabilities. You can
          request trial access by contacting the support team through the
          website.
        </p>
      </Card>
      <Card class="card-item faq">
        <H level="3">How robust are the algorithms?</H>
        <p>
          Cellbytes's algorithms have been trained on a comprehensive real-world
          dataset comprising different pathologies and over 60,000 samples. The
          system achieves high accuracy in detecting and classifying various
          blood cell types and their abnormalities, with performance metrics
          benchmarked against expert diagnoses.
        </p>
      </Card>
      <Card class="card-item faq">
        <H level="3"> Will Cellbytes replace hematopathologists? </H>
        <p>
          No, Cellbytes is designed to assist hematopathologists. It serves as a
          diagnostic aid that enhances efficiency and consistency. Final
          clinical decisions should always be made by a qualified medical
          professional.
        </p>
      </Card>
      <Card class="card-item faq">
        <H level="3">Why should I use Cellbytes?</H>
        <p>
          Cellbytes accelerates and enhances hematological analysis by providing
          AI-assisted interpretation of bone marrow cell images. Cellbytes will
          facilitate remote working and consultation but also reduce diagnostic
          turnaround time and improve standardization, particularly in
          high-volume settings.
        </p>
      </Card>
      <Card class="card-item faq">
        <H level="3">What types of images are supported?</H>
        <p>
          Cellbytes supports high-resolution digital images of May-Grünwald
          Giemsa stained bone marrow aspirate slides. Whole-slide images should
          be captured at 10x magnification and region-of-interest images should
          be acquired at 100x magnification. Cellbytes supports multiple imaging
          formats, such as DZI, SVS, VSI, CZI, MRXS, DICOM, and OME-TIFF.
        </p>
      </Card>
      <Card class="card-item faq">
        <H level="3">Why is Cellbytes only cloud-based?</H>
        <p>
          Being cloud-based ensures seamless updates, scalable computing
          resources, and consistent algorithm performance across users. It also
          allows for secure data storage and easy collaboration between
          institutes, laboratories and specialists across geographic locations.
        </p>
      </Card>
      <Card class="card-item faq">
        <H level="3"> What is the price of the Cellbytes license? </H>
        <p>
          Pricing depends on your usage volume. Contact the support team to test
          a trial version and discuss your needs.
        </p>
      </Card>
      <Card class="card-item faq">
        <H level="3">Can I use the application for research?</H>
        <p>
          Absolutely. Cellbytes is increasingly used in research settings to
          study hematologic disorders, develop new biomarkers, and support
          clinical trials. It offers data export and integration with other
          medical data domains.
        </p>
      </Card>
    </div>
  </BytesSection>
</Layout>

<style>
  .ingress {
    font-size: var(--text-size-ingress);
  }

  .workflow {
    counter-reset: step;
  }
  :global(.workflow > h2) {
    grid-column: content;
  }
  .workflow ol {
    display: grid;
    grid-template-areas: "image counter text";
    grid-template-columns: 1fr 6rem 1fr;
    column-gap: calc(2 * var(--element-padding));
    row-gap: calc(4 * var(--element-padding));
    position: relative;
  }
  .workflow ol::before {
    content: "";
    position: absolute;
    width: 1px;
    left: 50%;
    top: 8rem;
    bottom: 8rem;
    background-color: #d9d9d9;
    z-index: -1;
  }
  @media screen and (width < 70em) {
    .workflow ol {
      column-gap: calc(var(--element-padding));
    }
  }
  @media screen and (width < 50em) {
    .workflow ol {
      display: grid;
      grid-template-areas: "image text";
      grid-template-columns: 1fr 1fr;
    }
    .workflow ol::before {
      content: unset;
    }
  }

  .card-grid {
    place-self: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--element-padding);
    max-width: 70em;
    z-index: 1;
  }
  .card-item {
    flex: 25rem 1 1;
  }

  /* Doubled class to beat Card's own .card { display: flex } rule: the
     prod build inlines some component styles after the page stylesheet,
     so equal-specificity rules lose nondeterministically. */
  .feature.feature {
    display: grid;
    grid-template-areas:
      "icon heading"
      "icon paragraph";
    grid-template-columns: calc(var(--text-size-heading-1) + 1rem) auto;
    column-gap: var(--element-padding);
    row-gap: 0.5em;
    align-items: center;
  }

  /* The icon SVGs carry only a viewBox, so their width/height compute to
     auto (100%): Safari resolves that against the whole card instead of the
     icon track. Size them explicitly to the track width. */
  .feature svg {
    grid-area: icon;
    place-self: center;
    width: 100%;
    height: auto;
  }

  .bytes-corner {
    position: absolute;
    bottom: -5%;
    right: -10%;
    height: 100%;

    /* Retint this one instance of the artwork by overriding the token it
       paints with, rather than by overwriting its fills from out here. */
    --bytes-magenta: var(--bytes-light-magenta);
  }
  .faq {
    display: grid;
    gap: 0.5em;
  }
  @media (width > 61em) {
    .faq:last-child {
      max-width: calc(50% - (var(--element-padding) / 2));
    }
  }
</style>
