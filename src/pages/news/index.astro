---
import Layout from "~src/layouts/Layout.astro";
import Section from "~src/components/Section.astro";
import HeroSection from "~src/components/HeroSection.astro";
import LinkButton from "~src/components/LinkButton.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("news", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const accents = [
  "bytes-blue",
  "support-pink",
  "support-purple",
  "cells-dark-pink",
  "support-blue",
  "bytes-purple",
] as const;

function formatDate(date: Date) {
  return date.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Layout
  title="News | Cellbytes"
  description="Updates from the Cellbytes team on the Cellbytes application, digital pathology and related research."
>
  <HeroSection>
    <div class="text">
      <h1>News from Cellbytes</h1>
      <p>
        Updates from the Cellbytes team on the Cellbytes application, digital
        pathology and related research.
      </p>
    </div>
  </HeroSection>

  <Section>
    <section class="posts" aria-label="News articles">
      {
        posts.map((post, i) => {
          const accent = accents[i % accents.length];
          return (
            <article class="post-card" style={`--card-bg: var(--${accent})`}>
              <h2>
                <a href={`/news/${post.id}`}>{post.data.title}</a>
              </h2>
              <div class="post-meta">
                <time datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                {post.data.tags && (
                  <ul class="tag-list">
                    {post.data.tags.map((tag) => (
                      <li class="tag">{tag}</li>
                    ))}
                  </ul>
                )}
              </div>
              <p>{post.data.description}</p>
              <LinkButton
                variant="default-arrow"
                href={`/news/${post.id}`}
                aria-hidden
              >
                Read article
              </LinkButton>
            </article>
          );
        })
      }
    </section>
  </Section>
</Layout>

<style>
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: var(--element-padding);
    width: 100%;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: var(--element-padding);
    border-radius: var(--element-border-radius);
    background-color: var(--card-bg);
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  time {
    font-size: var(--text-size-label);
    font-style: italic;
    color: var(--text-color-body);
  }

  .tag-list {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.2em 0.75em;
    border-radius: var(--button-border-radius);
    background-color: var(--background);
    color: var(--text-color-heading);
  }

  h2 {
    text-align: start;
    font-size: var(--text-size-heading-3);
    font-weight: 600;
    line-height: 1.1;
  }

  h2 > a {
    text-decoration: none;
    color: var(--text-color-heading);
  }

  h2 > a:hover {
    text-decoration: underline;
  }

  .post-card > :global(.link-button) {
    align-self: flex-start;
    justify-self: flex-end;
    margin-top: auto;
  }
</style>
