---
import { getCollection } from "astro:content";
import BytesSmall from "~src/assets/backgrounds/bytes/cluster-mini.svg";
import CellsSmall from "~src/assets/backgrounds/cells/cluster-mini.svg";
import Layout from "~src/layouts/Layout.astro";
import Section from "~src/components/Section.astro";
import NewsCard from "~src/components/NewsCard.astro";

const posts = (await getCollection("news", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const accents = ["bytes-blue", "support-pink", "bytes-purple"] as const;
---

<Layout
  title="News | Cellbytes"
  description="Updates from the Cellbytes team on the Cellbytes application, digital pathology and related research."
>
  <Section>
    <CellsSmall class="cells" />
    <div class="text">
      <h1>News from Cellbytes</h1>
      <p>
        Updates from the Cellbytes team on the Cellbytes application, digital
        pathology and related research.
      </p>
    </div>
    <BytesSmall class="bytes" />
  </Section>

  <Section>
    <section class="posts" aria-label="News articles">
      {
        posts.map((post, i) => (
          <NewsCard post={post} accent={accents[i % accents.length]!} />
        ))
      }
    </section>
  </Section>
</Layout>

<style>
  :global(body) {
    min-height: 100vh;
  }

  :global(main) {
    row-gap: calc(var(--block-padding) / 2) !important;
  }

  .cells {
    position: absolute;
    height: 100px;
    left: 0;
    top: 0;
  }

  .bytes {
    position: absolute;
    height: 100px;
    right: 0;
    bottom: 0;
  }

  /* The clusters collide with the heading on narrow screens */
  @media screen and (width < 50em) {
    .cells,
    .bytes {
      display: none;
    }
  }

  .posts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--element-padding);
    width: 100%;
  }
</style>
