---
import Footer from "~src/components/Footer.astro";
import Navbar from "~src/components/Navbar.astro";
import {
  cardHeading,
  ogImagePath,
  ogSlug,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_TYPE,
  OG_IMAGE_WIDTH,
  type PageMeta,
} from "~src/utils/opengraph";
import { canonicalUrl } from "~src/utils/url";
import { graph } from "~src/utils/structuredData";
import "~src/styles/breathe.css";
import "~src/styles/reset.css";
import "~src/styles/theme.css";
import "~src/styles/artwork.css";

// A page declares this as its own `meta` export and spreads it in, so its copy
// stays in its own file. `src/pages/og/[...slug].jpg.ts` reads the same export
// to draw the card, and nobody has to name the card's URL: it follows from where
// the page lives, which is what `ogSlug` derives below.
interface Props extends PageMeta {
  /**
   * Structured-data nodes this page adds to the site-wide graph. The
   * organization and the site itself are always there; a page declares only
   * what it is on top of that.
   */
  jsonLd?: object[];
}

const meta = Astro.props;
const { title, description, ogType = "website", article, jsonLd } = meta;

// Crawlers only follow absolute image URLs, so resolve against the site origin.
const ogImageUrl = new URL(ogImagePath(ogSlug(Astro.url.pathname)), Astro.site);

// The address the page wants to be known by, which is not the one it was
// requested at: a tracking parameter, a stray trailing slash and the `.html` a
// flat build leaves on `Astro.url` are all the same page and must all point
// here, or each becomes a separate URL to an indexer.
const pageUrl = canonicalUrl(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- The only webfont, and it is declared inside a stylesheet, so without
      this the browser cannot start fetching it until it has parsed the CSS,
      which it cannot do until it has parsed this document. On a page that is
      mostly text that second round trip is the largest paint. `crossorigin` is
      required even same-origin: fonts are fetched anonymously, and a preload
      without it is a separate request the font never uses. -->
    <link
      rel="preload"
      href="/lato.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Cellbytes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content={OG_IMAGE_TYPE} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={cardHeading(meta)} />
    {
      article && (
        <>
          <meta
            property="article:published_time"
            content={article.published.toISOString()}
          />
          {article.modified && (
            <meta
              property="article:modified_time"
              content={article.modified.toISOString()}
            />
          )}
          {article.author && (
            <meta property="article:author" content={article.author} />
          )}
          {article.tags?.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script
      type="application/ld+json"
      is:inline
      set:html={graph(new URL(Astro.site ?? pageUrl.origin), jsonLd ?? [])}
    />

    <!-- For a page whose largest paint is something the browser would not
      find until it reached the body, such as a hero image behind a video. -->
    <slot name="head" />
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    display: grid;
    grid-template-rows: auto 1fr auto;
    grid-template-columns:
      [full-start]
      minmax(var(--element-padding), 1fr)
      [content-start]
      minmax(auto, calc(var(--column-width) / 2))
      [content-mid]
      minmax(auto, calc(var(--column-width) / 2))
      [content-end]
      minmax(var(--element-padding), 1fr)
      [full-end];
  }
  main {
    display: grid;
    grid-column: full;
    grid-template-columns: subgrid;
    row-gap: var(--block-padding);
    padding-block: var(--element-padding);
  }
  :global(main > *) {
    grid-column: content;
  }
</style>
