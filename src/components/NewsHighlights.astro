---
import { getCollection } from "astro:content";
import Section from "~src/components/Section.astro";
import H from "~src/components/HeadingLink.astro";
import NewsCard from "~src/components/NewsCard.astro";
import LinkButton from "~src/components/LinkButton.astro";

const posts = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const accents = [
  "bytes-purple",
  "bytes-blue",
  "support-purple",
  "support-pink",
] as const;
---

<Section>
  <H level="2">Latest news</H>
  <div class="posts">
    {
      posts.map((post, i) => (
        <NewsCard post={post} accent={accents[i % accents.length]!} level="3" />
      ))
    }
  </div>
  <LinkButton variant="default-arrow" href="/news">All news</LinkButton>
</Section>

<style>
  .posts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--element-padding);
    width: 100%;
  }
</style>
