---
import Section from "~src/components/Section.astro";
import H from "~src/components/HeadingLink.astro";
import NewsCard from "~src/components/NewsCard.astro";
import LinkButton from "~src/components/LinkButton.astro";
import { getNewsPosts } from "~src/utils/news";

// Slicing after the accents are assigned keeps each post the same color here as
// in the full listing on /news.
const posts = (await getNewsPosts()).slice(0, 3);
---

<Section>
  <H level="2">Latest news</H>
  <div class="posts">
    {
      posts.map(({ post, accent }) => (
        <NewsCard post={post} accent={accent} level="3" />
      ))
    }
  </div>
  <LinkButton variant="default-arrow" href="/news">All news</LinkButton>
</Section>

<style>
  .posts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--element-padding);
    width: 100%;
  }
</style>
