---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { WIDTHS } from "~src/consts";
import { imageNeedsFrame } from "~src/utils/image";

interface Props {
  image?: ImageMetadata | undefined;
  alt?: string | undefined;
  accent: "bytes-blue" | "bytes-purple" | "support-pink";
}
const { image, alt, accent } = Astro.props;
const bg = `var(--${accent})`;

// Images that are transparent or have a mostly white perimeter blend into a
// light background, so they need a frame to stay visible. Others do not.
const framed = image ? await imageNeedsFrame(image) : false;
---

<article class:list={[{ framed }]}>
  {
    image && (
      <Image
        src={image}
        alt={alt ?? ""}
        widths={WIDTHS}
        height="200"
        width="350"
      />
    )
  }
  <div class="content">
    <slot />
  </div>
</article>

<style define:vars={{ bg }}>
  article {
    display: flex;
    align-items: center;
    max-width: 65rem;

    background-color: var(--bg);
    border-radius: var(--element-border-radius);

    --outline-width: calc(0.25 * var(--element-padding));
  }
  img {
    border-radius: var(--element-border-radius);
    height: 100%;
    background-color: var(--background);
    outline: var(--outline-width) solid var(--background);
  }
  /* Frame only transparent images so they read against a light background. */
  article.framed img {
    border: 2px solid var(--bg);
  }
  .content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;

    padding: var(--element-padding);
  }

  @media screen and (width >= 50em) {
    article.framed .content {
      padding-inline-start: calc(var(--element-padding) + var(--outline-width));
    }
  }
  @media screen and (width < 50em) {
    article {
      flex-direction: column;
    }
    article.framed .content {
      padding-block-start: calc(var(--element-padding) + var(--outline-width));
    }
    img {
      width: 100%;
      height: 200px;
    }
  }
</style>
