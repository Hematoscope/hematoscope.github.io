---
import Section from "~src/components/Section.astro";
import H from "~src/components/HeadingLink.astro";

/**
 * A lineage in the cell differential, and the classes reported under it.
 *
 * `dysplasia` marks a lineage the dysplasia assessment covers, which is what
 * the asterisk in the listing means. A member may nest one level further,
 * which is how a neutrophil splits into band and segmented forms.
 */
interface Lineage {
  name: string;
  color: string;
  dysplasia?: boolean;
  members: (string | { name: string; members: string[] })[];
}

// The lineage colors the application paints cell boxes and differentials with,
// so a reader recognizes the same grouping in the product.
const ERYTHROID = "#f0ae92";
const BLASTS = "#ff4488";
const GRANULOCYTIC = "#afc9f1";
const LYMPHOID = "#b4d295";
const MONOCYTIC = "#fff09c";
const OTHER = "#cccccc";

const BONE_MARROW: Lineage[] = [
  {
    name: "Erythroid",
    color: ERYTHROID,
    dysplasia: true,
    members: ["Proerythroblast", "Erythroblast"],
  },
  {
    name: "Blasts",
    color: BLASTS,
    dysplasia: true,
    members: ["Blast", "Promonocyte"],
  },
  {
    name: "Granulocytic",
    color: GRANULOCYTIC,
    dysplasia: true,
    members: [
      "Promyelocyte",
      "Myelocyte",
      "Metamyelocyte",
      "Neutrophil",
      "Basophil",
      { name: "Eosinophils", members: ["Mature", "Immature"] },
    ],
  },
  {
    name: "Lymphoid",
    color: LYMPHOID,
    dysplasia: true,
    members: ["Lymphocyte", "Plasma cell"],
  },
  {
    name: "Monocytic",
    color: MONOCYTIC,
    members: ["Monocyte", "Macrophage"],
  },
  {
    name: "Other",
    color: OTHER,
    members: ["Artefact", "Megakaryocyte *"],
  },
];

const PERIPHERAL_BLOOD: Lineage[] = [
  { name: "Erythroblast", color: ERYTHROID, members: [] },
  { name: "Blasts", color: BLASTS, members: ["Blast", "Promonocyte"] },
  {
    name: "Granulocytic",
    color: GRANULOCYTIC,
    members: [
      "Promyelocyte",
      "Myelocyte",
      "Metamyelocyte",
      { name: "Neutrophil", members: ["Band", "Segmented"] },
      "Basophil",
      "Eosinophils",
    ],
  },
  {
    name: "Lymphoid",
    color: LYMPHOID,
    members: ["Lymphocyte", "Plasma cell"],
  },
  { name: "Monocyte", color: MONOCYTIC, members: [] },
  { name: "Artefact", color: OTHER, members: [] },
];

/** Dysplasia features, by the lineage they are assessed on. */
const PB_DYSPLASIAS = [
  {
    lineage: "Blasts / immature granulocytes",
    types: ["Bilobed nucleus", "Auer rods", "Vacuolated"],
  },
  { lineage: "Mature granulocytes", types: ["Vacuolated"] },
  { lineage: "Lymphocytes", types: ["Vacuolated"] },
  { lineage: "Plasma cells", types: ["Vacuolated"] },
];

const MORPHOLOGY = ["Size", "Shape"];
const SAMPLE_LEVEL = [
  "Clusters",
  "Megakaryocyte count",
  "Cellularity",
  "Sample sufficiency",
];
---

<Section class="features">
  <H level="2">Cellbytes features</H>
  <p class="ingress">
    Cellbytes delivers a comprehensive cytomorphological assessment, including
    whole-slide analysis, cell classification, and dysplasia detection. Every
    algorithm is built on high-quality data covering normal and pathological
    varieties, cutting-edge research and validated by robust scientific and
    clinical metrics. By trusting Cellbytes, you will receive an extensive data
    package.
  </p>

  <div class="sample-type">
    <H level="3">1. Bone marrow samples</H>

    <H level="4">Cell differentials and dysplasias</H>
    <ul class="lineages">
      {
        BONE_MARROW.map((lineage) => (
          <li style={`--lineage: ${lineage.color}`}>
            <span class="lineage">
              {lineage.name}
              {lineage.dysplasia && " *"}
            </span>
            {lineage.members.length > 0 && (
              <ul>
                {lineage.members.map((member) =>
                  typeof member === "string" ? (
                    <li>{member}</li>
                  ) : (
                    <li>
                      {member.name}
                      <ul>
                        {member.members.map((sub) => (
                          <li>{sub}</li>
                        ))}
                      </ul>
                    </li>
                  ),
                )}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
    <p class="footnote">* Assessed for dysplasia.</p>

    <dl class="assessments">
      <div>
        <dt>Dysplasia types</dt>
        <dd>Bilobed nucleus, Auer rods, Vacuolated</dd>
      </div>
      <div>
        <dt>Morphology</dt>
        <dd>{MORPHOLOGY.join(", ")}</dd>
      </div>
      <div>
        <dt>Sample-level</dt>
        <dd>{SAMPLE_LEVEL.join(", ")}</dd>
      </div>
    </dl>
  </div>

  <div class="sample-type">
    <H level="3">2. Peripheral blood samples</H>

    <H level="4">Cell differentials</H>
    <ul class="lineages">
      {
        PERIPHERAL_BLOOD.map((lineage) => (
          <li style={`--lineage: ${lineage.color}`}>
            <span class="lineage">{lineage.name}</span>
            {lineage.members.length > 0 && (
              <ul>
                {lineage.members.map((member) =>
                  typeof member === "string" ? (
                    <li>{member}</li>
                  ) : (
                    <li>
                      {member.name}
                      <ul>
                        {member.members.map((sub) => (
                          <li>{sub}</li>
                        ))}
                      </ul>
                    </li>
                  ),
                )}
              </ul>
            )}
          </li>
        ))
      }
    </ul>

    <dl class="assessments">
      {
        PB_DYSPLASIAS.map((entry) => (
          <div>
            <dt>{entry.lineage}</dt>
            <dd>{entry.types.join(", ")}</dd>
          </div>
        ))
      }
      <div>
        <dt>Morphology</dt>
        <dd>{MORPHOLOGY.join(", ")}</dd>
      </div>
    </dl>
  </div>
</Section>

<style>
  .ingress {
    font-size: var(--text-size-ingress);
    max-width: 60ch;
  }

  .sample-type {
    width: 100%;
    max-width: 60em;
    margin-inline: auto;
  }
  .sample-type + .sample-type {
    margin-block-start: calc(2 * var(--element-padding));
  }
  .sample-type :global(h4) {
    margin-block: var(--element-padding) 0.5em;
  }

  /* The lineages read as columns rather than as one long list: the reader is
     scanning for a class name, not working down an ordered sequence. Each
     column is only as tall as its own classes, so the accent bar measures the
     lineage rather than the tallest one on the row. */
  .lineages {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--element-padding);
    list-style: none;
    padding: 0;
  }
  .lineages > li {
    flex: 12rem 1 1;
    max-width: 18rem;
    border-inline-start: 4px solid var(--lineage);
    padding-inline-start: 0.75em;
  }
  .lineage {
    font-weight: bold;
    color: var(--text-color-heading);
  }
  .lineages ul {
    list-style: none;
    padding-inline-start: 0.75em;
  }

  .footnote {
    font-size: var(--text-size-label);
    opacity: 0.75;
  }

  .assessments {
    display: flex;
    flex-wrap: wrap;
    gap: var(--element-padding);
    margin-block-start: var(--element-padding);
  }
  .assessments > div {
    flex: 16rem 1 1;
  }
  dt {
    font-weight: bold;
    color: var(--text-color-heading);
  }
</style>
