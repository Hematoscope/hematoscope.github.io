---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {}
const props = Astro.props;
---

<section {...props}>
  <slot />
</section>

<style>
  section {
    position: relative;
    border-radius: var(--element-border-radius);

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--element-padding);
  }
  section > :global(h1),
  section > :global(h2) {
    text-align: center;
  }
</style>
