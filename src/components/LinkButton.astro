---
import type { HTMLAttributes, HTMLTag } from "astro/types";

interface Props extends Omit<HTMLAttributes<"a">, "type"> {
  /** Renders a submit button instead of a link when omitted. */
  href?: string;
  variant?:
    | "highlight"
    | "default"
    | "default-arrow"
    | "default-arrow-back"
    | "external";
}
const { variant = "default", ...props } = Astro.props;
const Tag: HTMLTag = props.href ? "a" : "button";
---

<Tag
  class:list={[props.class, "link-button", ...variant.split("-")]}
  {...props}
>
  {
    variant === "default-arrow-back" && (
      <svg width="1em" height="1em" viewBox="0 0 17 16" aria-hidden>
        <path d="M8.875 1.25L15.625 8L8.875 14.75M14.6875 8H1" />
      </svg>
    )
  }
  <slot />
  {
    variant === "default-arrow" && (
      <svg width="1em" height="1em" viewBox="0 0 17 16" aria-hidden>
        <path d="M8.875 1.25L15.625 8L8.875 14.75M14.6875 8H1" />
      </svg>
    )
  }
  {
    variant === "external" && (
      <svg width="1em" height="1em" viewBox="0 0 18 18" aria-hidden>
        <path d="M13 14V17H1V5H4" />
        <path d="M7.18198 10.6065L14.253 3.53547M8.24264 3.18192H14.6066V9.54588" />
      </svg>
    )
  }
</Tag>

<style>
  .link-button {
    font-weight: 600;
    font-size: var(--text-size-label);
    text-decoration: none;
    border: none;
    cursor: pointer;
    color: var(--primary-1);
    background-color: var(--background);

    display: flex;
    align-items: center;
    gap: 0.5em;

    padding: 0.75rem 1.5rem;
    border-radius: var(--button-border-radius);
  }

  /* Highlight variant styles */
  .highlight {
    color: var(--background);
    background-color: var(--highlight);

    transition: box-shadow 0.5s;
    --shadow-height: 18px;
    --shadow-distance: 4px;
    box-shadow: 0px var(--shadow-distance) var(--shadow-height)
      rgb(from var(--highlight) r g b / 0.5);
  }
  .highlight:hover {
    --shadow-height: 32px;
    --shadow-distance: 8px;
  }
  .highlight:active {
    transition: box-shadow 0.1s;
    --shadow-height: 12px;
    --shadow-distance: 2px;
  }

  /* Default variant styles */
  .default {
    color: var(--text-color-heading);
    border: 1px solid var(--primary-1);
  }

  .external {
    color: var(--text-color-heading);
    border: 1px solid var(--primary-1);
    --translate: 0px, 0px;
  }

  .external path:nth-child(2) {
    transition: transform 0.1s ease-in-out;
    transform: translate(var(--translate));
  }

  .external:hover {
    --translate: 2px, -2px;
  }

  .external:active {
    --translate: -2px 2px;
  }

  /* Icon variant styles */
  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;

    transition: transform 0.1s ease-in-out;
    transform: translateX(var(--translate));
  }
  .arrow {
    padding: 0.75rem 1.25rem 0.75rem 1.5rem;
    --translate: 0px;
  }
  .arrow:hover {
    --translate: 3px;
  }
  .arrow:active {
    --translate: -1px;
  }
  .back {
    padding: 0.75rem 1.5rem 0.75rem 1.25rem;
  }
  .back svg {
    transform: translateX(calc(-1 * var(--translate))) rotate(180deg);
  }
</style>
