---
import LinkedIn from "~src/assets/icons/linkedin.svg";
---

<footer>
  <div class="contents">
    <p>
      <strong>Cellbytes</strong><br />
      © Cellbytes Ltd.<br />
      Tukholmankatu 8,<br />
      00290 Helsinki, Finland<br />
      All rights reserved.
    </p>

    <ul>
      <li>
        <a href="https://www.linkedin.com/company/cellbytes">
          <LinkedIn />
        </a>
      </li>
    </ul>

    <div class="links">
      <a href="/privacy-policy">Privacy policy</a>
      <a href="/equality-policy">Equality policy</a>
    </div>
  </div>
</footer>

<style>
  footer {
    grid-column: full;
    display: grid;
    grid-template-columns: subgrid;
    background-color: var(--footer-background);
    min-height: 16rem;
    margin-top: 5rem;
  }
  .contents {
    grid-column: content;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  p,
  a {
    color: var(--background);
  }
  ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 2em;
  }
  li svg {
    width: 2em;
    height: 2em;
  }

  div.links {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }

  @media screen and (width < 50em) {
    .contents {
      flex-direction: column;
      padding-block: calc(2 * var(--element-padding));
      gap: var(--element-padding);
    }
  }
</style>
